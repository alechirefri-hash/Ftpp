rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /games/{gameId} {
      allow read: if true;
      allow write: if isValidId(gameId) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 200;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId) &&
        request.resource.data.username is string &&
        request.resource.data.username.size() <= 100;
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
